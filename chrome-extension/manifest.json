{
  "manifest_version": 3,
  "name": "Smart Expense Tracker - Auto Detector",
  "version": "1.0",
  "description": "Automatically detects and logs expenses from payment pages.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:3001/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:3001/*", "http://localhost:5173/*", "file://*/*"],
      "js": ["content.js"]
    }
  ]
}
